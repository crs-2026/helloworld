pipeline {
    agent any

    stages {
                stage('Get Code') {
                    steps {
                        git branch: 'Master', url: 'https://github.com/crs-2026/helloworld.git'
                    }
                }
        
                stage ('Unit') {
                    steps {
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        sh '''
                            export PYTHONPATH=$WORKSPACE
                            pytest --junitxml=result-unit.xml test/unit
                        '''
                        }
                        junit testResults: 'result-unit.xml'
                    }
                }
                
                stage ('Rest') {
                    steps {
                        sh '''
                        rm -rf .venv
                        python3 -m venv .venv
                        . .venv/bin/activate
                       
                        export FLASK_APP=app/api.py
                        export PYTHONPATH=$WORKSPACE
                        
                        flask run &
                        FLASK_PID=$!
                        java -jar /home/crs/Descargas/wiremock-standalone-3.13.2.jar --port 9090 --root-dir test/wiremock &
                        WIREMOCK_PID=$!
                        sleep 5
                        
                        pytest --junitxml=result-rest.xml test/rest
                        kill $FLASK_PID
                        kill $WIREMOCK_PID
                        '''
                        junit testResults: 'result-rest.xml'
                          }
                          
                  }
         
                stage ('Static'){
                      steps {
                          sh '''
                          export PYTHONPATH=$WORKSPACE
                          python3 -m flake8 --exit-zero --format=pylint app >flake8.out
                          '''
                          recordIssues tools: [flake8(name: 'flake8', pattern: 'flake8.out')],
                              qualityGates: [
                                  [threshold: 8, type:'TOTAL', unstable: true], 
                                  [threshold: 10, type: 'TOTAL', unstable: false]
                            ]
                          
                      }
                  }
        
                  stage('Security Test'){
                  steps {
                      sh '''
                       export PYTHONPATH="${WORKSPACE}"
                       # 1. Create a virtual environment using Python 3.12
                       python3.12 -m venv venv
                
                       # 2. Activate it
                       . venv/bin/activate
                
                        # 3. Install Bandit inside this specific bubble
                        pip install --upgrade pip
                        pip install bandit
                        python3.12 -m bandit --exit-zero -r ./test -f custom -o bandit.out \
                            --msg-template "{abspath}:{line}: [{test_id}({severity})] {msg}"
                            '''
                            
                            recordIssues tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')],
                                qualityGates: [
                                    [threshold: 2, type:'TOTAL', unstable: true], 
                                    [threshold: 4, type: 'TOTAL', unstable: false]
                                ]
            }
        }
             
        
        stage ('Coverage'){
                  steps{
                          sh '''
                          export PYTHONPATH=.
                          python3 -m coverage run  --branch --source=app --omit=app/__init__.py,app/api.py  -m pytest --junitxml=result-unit.xml test/unit
                          python3 -m coverage xml
                          '''
                          
                         recordCoverage(
                            tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']],
                            // El pipeline continuará aunque las métricas fallen gracias a que recordCoverage
                            // por defecto no detiene el flujo a menos que se fuerce explícitamente.
                            qualityGates: [
                                // --- Cobertura de LÍNEAS ---
                                // Si es menor a 85.0 -> Rojo (ERROR)
                                [threshold: 85.0, metric: 'LINE', criticality: 'ERROR'],
                                // Si es menor a 95.0 -> Amarillo (UNSTABLE)
                                [threshold: 95.0, metric: 'LINE', criticality: 'UNSTABLE'],
                
                                // --- Cobertura de RAMAS (Branches) ---
                                // Si es menor a 80.0 -> Rojo (ERROR)
                                [threshold: 80.0, metric: 'BRANCH', criticality: 'ERROR'],
                                // Si es menor a 90.0 -> Amarillo (UNSTABLE)
                                [threshold: 90.0, metric: 'BRANCH', criticality: 'UNSTABLE']
                            ]
                        )
                  }
              }
      
              stage('Performance')
              {
                  steps
                  {
                     sh '''
                      python3 -m venv .venv
                            . .venv/bin/activate
                               
                            export FLASK_APP=app/api.py
                            export PYTHONPATH=$WORKSPACE
                                
                            flask run &
                            FLASK_PID=$!
                      /home/crs/apache-jmeter-5.6.3/bin/jmeter.sh -n -t test/jmeter/flask.jmx -f -l flask.jtl
                      kill $FLASK_PID
                      '''
                      perfReport sourceDataFiles: 'flask.jtl'
                  }
              }
              
         }
post {
        always {
            cleanWs()
        }
    }
}
